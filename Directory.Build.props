<Project>

  <!--
    Version scheme aligned with Antigravity releases:
        Version:      <AntigravityVersion>.<Revision>   e.g. 2.29.0.01
        VersionCode:  Numeric representation            e.g. 229001

    All versions are manually specified. You can edit them directly here,
    or override via a local 'version.props' file.
  -->
  <Import Project="version.props" Condition="Exists('version.props')" />

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">2.29.0.001</Version>
    <VersionCode Condition="'$(VersionCode)' == ''">2290001</VersionCode>
  </PropertyGroup>

</Project>
