<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandAccentColor">#FF4285F4</Color>
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandAccentFillSoftBrush" Color="#1A4285F4" />
    <SolidColorBrush x:Key="BrandAccentFillMediumBrush" Color="#224285F4" />
    <SolidColorBrush x:Key="BrandAccentFillStrongBrush" Color="#264285F4" />
    <SolidColorBrush x:Key="BrandAccentFillStrongerBrush" Color="#334285F4" />
    <SolidColorBrush x:Key="BrandAccentTextBrush" Color="#8AB4F8" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#34A853" />
    <SolidColorBrush x:Key="StatusSuccessFillSoftBrush" Color="#1A34A853" />
    <SolidColorBrush x:Key="StatusSuccessFillFaintBrush" Color="#1834A853" />
    <SolidColorBrush x:Key="StatusCautionBrush" Color="#FBBC04" />
    <SolidColorBrush x:Key="StatusCautionFillSoftBrush" Color="#1AFBBC04" />
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#EA4335" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#80868B" />

    <SolidColorBrush x:Key="OverlaySeparatorBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="OverlaySurfaceFaintBrush" Color="#18FFFFFF" />

    <SolidColorBrush x:Key="TranscriptUserCardBrush" Color="#242B38" />
    <SolidColorBrush x:Key="TranscriptUserBorderBrush" Color="#3B5998" />
    <SolidColorBrush x:Key="TranscriptAssistantCardBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TranscriptThinkingCardBrush" Color="#161616" />
    <SolidColorBrush x:Key="TranscriptToolCallBrush" Color="#141820" />
    <SolidColorBrush x:Key="TranscriptToolOutputBrush" Color="#111111" />
    <!-- Window surface base; alpha is driven at runtime by the opacity slider -->
</ResourceDictionary>
