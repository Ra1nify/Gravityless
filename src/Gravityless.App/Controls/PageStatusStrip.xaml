<UserControl x:Class="Gravityless.App.Controls.PageStatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing x:Name="Ring" Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"/>
        <TextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                   TextTrimming="CharacterEllipsis"/>
        <ui:Button x:Name="CancelButton" Appearance="Secondary" Padding="8,2" Margin="12,0,0,0"
                   FontSize="11" Visibility="Collapsed" Click="OnCancelClicked"/>
    </StackPanel>
</UserControl>
