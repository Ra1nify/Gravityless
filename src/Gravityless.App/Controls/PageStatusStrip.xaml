<UserControl x:Class="Gravityless.App.Controls.PageStatusStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed">
    <!--
        Progress strip for a page-level operation. The border gives the text a surface;
        without it the message reads as loose copy sitting on the page background.
        Brushes are the theme's neutral fills so the strip follows light and dark.
    -->
    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:ProgressRing x:Name="Ring" Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"/>
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                       TextTrimming="CharacterEllipsis"/>
            <ui:Button x:Name="CancelButton" Appearance="Secondary" Padding="8,2" Margin="12,0,0,0"
                       FontSize="11" Visibility="Collapsed" Click="OnCancelClicked"/>
        </StackPanel>
    </Border>
</UserControl>
