<ui:FluentWindow x:Class="Gravityless.App.Dialogs.ModernDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="480"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="560"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" Title="{DynamicResource Common_Notice}" ShowMaximize="False" ShowMinimize="False"/>

        <!-- 48px icon column aligns with the icon badge -->
        <Grid Grid.Row="1" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource OverlaySurfaceFaintBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                <ui:SymbolIcon x:Name="DialogIcon" Symbol="Info24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock x:Name="DialogHeadingText" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DialogMessageText" TextWrapping="Wrap" LineHeight="20" Opacity="0.85" FontSize="13"/>
                </ScrollViewer>

                <ui:TextBox AutomationProperties.AutomationId="ModernDialogInputBox" x:Name="DialogInputBox" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,16">
            <ui:Button AutomationProperties.AutomationId="ModernDialogTertiaryBtn" x:Name="TertiaryBtn" Content="" Click="OnTertiaryClicked" Appearance="Secondary" Margin="0,0,10,0" Visibility="Collapsed" MinWidth="80"/>
            <ui:Button AutomationProperties.AutomationId="ModernDialogSecondaryBtn" x:Name="SecondaryBtn" Content="{DynamicResource Common_Cancel}" Click="OnSecondaryClicked" Appearance="Secondary" Margin="0,0,10,0" Visibility="Collapsed" MinWidth="80"/>
            <ui:Button AutomationProperties.AutomationId="ModernDialogPrimaryBtn" x:Name="PrimaryBtn" Content="{DynamicResource Common_Confirm}" Click="OnPrimaryClicked" Appearance="Primary" MinWidth="80"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
