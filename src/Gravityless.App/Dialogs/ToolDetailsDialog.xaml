<ui:FluentWindow x:Class="Gravityless.App.Dialogs.ToolDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="工具详情"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="420"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="Transparent">

    <Grid Margin="0,0,0,16" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,8,24,12">
            <StackPanel>

                <ui:Card Margin="0,0,0,14" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BrandAccentFillMediumBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Sparkle24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubtitleText" FontSize="11" Opacity="0.5" Margin="0,3,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <TextBlock Text="{DynamicResource Tools_DetailDescription}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,6"/>
                <ui:Card Margin="0,0,0,14" Padding="14,12">
                    <TextBlock x:Name="DescriptionText" FontSize="13" Opacity="0.85" TextWrapping="Wrap" LineHeight="21"/>
                </ui:Card>

                <TextBlock Text="{DynamicResource Tools_DetailMeta}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,6"/>
                <ui:Card Margin="0,0,0,14" Padding="14,12">
                    <StackPanel x:Name="MetaPanel"/>
                </ui:Card>

                <StackPanel x:Name="RawJsonSection" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Tools_DetailRawJson}" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,6"/>
                    <ui:Card Margin="0,0,0,4" Padding="12,10">
                        <TextBox x:Name="RawJsonText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0" Background="Transparent"/>
                    </ui:Card>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,0">
            <ui:Button x:Name="BtnEditSkillMd" Visibility="Collapsed" Appearance="Secondary" Margin="0,0,8,0"
                       Click="OnEditSkillMdClicked" Icon="{ui:SymbolIcon Symbol=DocumentEdit24}"/>
            <ui:Button x:Name="BtnOpenFolder" Visibility="Collapsed" Appearance="Secondary" Margin="0,0,8,0"
                       Click="OnOpenFolderClicked" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
            <ui:Button x:Name="BtnDelete" Visibility="Collapsed" Appearance="Danger" Margin="0,0,8,0"
                       Click="OnDeleteClicked" Icon="{ui:SymbolIcon Symbol=Delete24}"/>
            <ui:Button x:Name="BtnClose" Appearance="Primary" MinWidth="88" Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
