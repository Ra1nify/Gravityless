<ui:FluentWindow x:Class="Gravityless.App.Dialogs.ToolDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Tools_DetailTitle}"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="420"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="DialogTitleBar" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,12">
            <StackPanel>

                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,14" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource FluentControlCornerRadius}" Background="{DynamicResource BrandAccentFillMediumBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Sparkle24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" Style="{StaticResource FluentSubtitleStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubtitleText" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.55" Margin="0,3,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Tools_DetailDescription}" Style="{StaticResource FluentBodyStrongStyle}" Margin="2,0,0,6"/>
                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,14" Padding="14,12">
                    <TextBlock x:Name="DescriptionText" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85" TextWrapping="Wrap" LineHeight="21"/>
                </Border>

                <TextBlock Text="{DynamicResource Tools_DetailMeta}" Style="{StaticResource FluentBodyStrongStyle}" Margin="2,0,0,6"/>
                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,14" Padding="14,12">
                    <StackPanel x:Name="MetaPanel"/>
                </Border>

                <StackPanel x:Name="RawJsonSection" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Tools_DetailRawJson}" Style="{StaticResource FluentBodyStrongStyle}" Margin="2,0,0,6"/>
                    <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,4" Padding="12,10">
                        <TextBox x:Name="RawJsonText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11.5" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0" Background="Transparent"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
            <ui:Button AutomationProperties.AutomationId="ToolDetailEditBtn" x:Name="BtnEditSkillMd" Visibility="Collapsed" Appearance="Secondary" Margin="0,0,8,0"
                       Click="OnEditSkillMdClicked" Icon="{ui:SymbolIcon Symbol=DocumentEdit24}"/>
            <ui:Button AutomationProperties.AutomationId="ToolDetailOpenFolderBtn" x:Name="BtnOpenFolder" Visibility="Collapsed" Appearance="Secondary" Margin="0,0,8,0"
                       Click="OnOpenFolderClicked" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
            <ui:Button AutomationProperties.AutomationId="ToolDetailDeleteBtn" x:Name="BtnDelete" Visibility="Collapsed" Appearance="Secondary" Foreground="{DynamicResource StatusCriticalBrush}" Margin="0,0,8,0"
                       Click="OnDeleteClicked" Icon="{ui:SymbolIcon Symbol=Delete24}"/>
            <ui:Button AutomationProperties.AutomationId="ToolDetailCloseBtn" x:Name="BtnClose" Appearance="Primary" MinWidth="88" Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
