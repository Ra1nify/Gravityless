<ui:FluentWindow x:Class="Gravityless.App.Dialogs.ProjectConversationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource ProjectConversations_Title}" 
        Width="880"
        Height="620"
        MinHeight="460"
        MinWidth="680"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">

    <Grid Margin="0,0,0,16" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{DynamicResource ProjectConversations_TitleBar}" ShowMaximize="True" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="24,8,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectTitleText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BrandAccentFillSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProjectConvoCountBadge" FontSize="11" Foreground="{DynamicResource BrandAccentTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ProjectPathText" Opacity="0.55" FontSize="11" Margin="28,3,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{DynamicResource ProjectConversations_ExportAllBtn}" Click="OnExportAllClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Margin="0,0,8,0" Padding="10,5"/>
                        <ui:Button Click="OnRefreshClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" Padding="8,5" ToolTip="{DynamicResource ProjectConversations_RefreshTip}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <ui:TextBox x:Name="SearchBox" 
                            PlaceholderText="{DynamicResource ProjectConversations_SearchPlaceholder}" 
                            TextChanged="OnSearchTextChanged"
                            Icon="{ui:SymbolIcon Symbol=Search24}"/>
            </Grid>

            <ListView Grid.Row="2" x:Name="ConversationsListView" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,3,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Chat24" Foreground="{DynamicResource StatusSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="{DynamicResource StatusSuccessFillSoftBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StepCount}" FontSize="11" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                                <TextBlock Text="{DynamicResource ProjectConversations_StepsUnit}" FontSize="11" Foreground="{DynamicResource StatusSuccessBrush}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 26px left margin matches the row icon + gap -->
                                    <StackPanel Orientation="Horizontal" Margin="26,4,0,0">
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="11" Opacity="0.55" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding ShortId, StringFormat='ID: {0}'}" FontSize="11" Opacity="0.45" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="26,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ui:Button Content="{DynamicResource ProjectConversations_PreviewBtn}" 
                                               Click="OnPreviewItemClicked" 
                                               Tag="{Binding ConversationId}" 
                                               Appearance="Primary" 
                                               Margin="0,0,6,0" 
                                               Padding="10,5" 
                                               Icon="{ui:SymbolIcon Symbol=Eye24}"/>
                                    <ui:Button ToolTip="{DynamicResource ProjectConversations_RenameTip}" 
                                               Click="OnRenameItemClicked" 
                                               Tag="{Binding ConversationId}" 
                                               Appearance="Secondary" 
                                               Margin="0,0,6,0" 
                                               Padding="8,5" 
                                               Icon="{ui:SymbolIcon Symbol=Rename24}"/>
                                    <ui:Button ToolTip="{DynamicResource ProjectConversations_CopyIdTip}" 
                                               Click="OnCopyIdClicked" 
                                               Tag="{Binding ConversationId}" 
                                               Appearance="Secondary" 
                                               Margin="0,0,6,0" 
                                               Padding="8,5" 
                                               Icon="{ui:SymbolIcon Symbol=Copy24}"/>
                                    <ui:Button ToolTip="{DynamicResource ProjectConversations_OpenBrainTip}" 
                                               Click="OnOpenBrainFolderClicked" 
                                               Tag="{Binding ConversationId}" 
                                               Appearance="Secondary" 
                                               Margin="0,0,6,0" 
                                               Padding="8,5" 
                                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
                                    <ui:Button ToolTip="{DynamicResource ProjectConversations_DeleteTip}" 
                                               Click="OnDeleteItemClicked" 
                                               Tag="{Binding ConversationId}" 
                                               Appearance="Danger" 
                                               Padding="8,5" 
                                               Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Common_Close}" Click="OnCloseClicked" Appearance="Secondary" Padding="16,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
