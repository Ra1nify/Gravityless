<ui:FluentWindow x:Class="Gravityless.App.Dialogs.ProjectConversationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource ProjectConversations_Title}" 
        Width="880"
        Height="620"
        MinHeight="460"
        MinWidth="680"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{DynamicResource ProjectConversations_TitleBar}" ShowMaximize="True" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="24,10,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="{StaticResource FluentCardCornerRadius}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectTitleText" Style="{StaticResource FluentBodyStrongStyle}" FontSize="14" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource FluentBadgeBorderStyle}"
                                    Background="{DynamicResource BrandAccentFillSoftBrush}"
                                    Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProjectConvoCountBadge" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ProjectPathText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.58" FontSize="11.5" Margin="28,4,0,0" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button AutomationProperties.AutomationId="ProjectConvosExportAllBtn" Content="{DynamicResource ProjectConversations_ExportAllBtn}" Click="OnExportAllClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Margin="0,0,6,0" Padding="12,5"/>
                        <Button AutomationProperties.AutomationId="ProjectConvosRefreshBtn"
                                AutomationProperties.Name="{DynamicResource ProjectConversations_RefreshTip}"
                                Click="OnRefreshClicked"
                                Style="{StaticResource FluentBorderlessButtonStyle}"
                                Padding="7,5"
                                ToolTip="{DynamicResource ProjectConversations_RefreshTip}">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Opacity="0.78"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <ui:TextBox AutomationProperties.AutomationId="ProjectConvosSearchBox"
                            x:Name="SearchBox"
                            PlaceholderText="{DynamicResource ProjectConversations_SearchPlaceholder}"
                            TextChanged="OnSearchTextChanged"
                            Icon="{ui:SymbolIcon Symbol=Search24}"/>
            </Grid>

            <ListView AutomationProperties.AutomationId="ProjectConvosListView" Grid.Row="2" x:Name="ConversationsListView" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Chat24" Foreground="{DynamicResource StatusSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource FluentBodyStrongStyle}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Style="{StaticResource FluentBadgeBorderStyle}"
                                                Background="{DynamicResource StatusSuccessFillSoftBrush}"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StepCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                                <TextBlock Text="{DynamicResource ProjectConversations_StepsUnit}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessBrush}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="26,4,0,0">
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.58" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ShortId, StringFormat='ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.48" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Preview}" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.68" TextTrimming="CharacterEllipsis" Margin="26,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ui:Button Content="{DynamicResource ProjectConversations_PreviewBtn}"
                                               Click="OnPreviewItemClicked"
                                               Tag="{Binding ConversationId}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,0"
                                               Padding="12,5"
                                               Icon="{ui:SymbolIcon Symbol=Eye24}"/>
                                    <Button ToolTip="{DynamicResource ProjectConversations_RenameTip}"
                                            Style="{StaticResource FluentBorderlessButtonStyle}"
                                            Click="OnRenameItemClicked"
                                            Tag="{Binding ConversationId}"
                                            Margin="0,0,2,0"
                                            Padding="7,5">
                                        <ui:SymbolIcon Symbol="Rename24" FontSize="15" Opacity="0.78"/>
                                    </Button>
                                    <Button ToolTip="{DynamicResource ProjectConversations_CopyIdTip}"
                                            Style="{StaticResource FluentBorderlessButtonStyle}"
                                            Click="OnCopyIdClicked"
                                            Tag="{Binding ConversationId}"
                                            Margin="0,0,2,0"
                                            Padding="7,5">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="15" Opacity="0.78"/>
                                    </Button>
                                    <Button ToolTip="{DynamicResource ProjectConversations_OpenBrainTip}"
                                            Style="{StaticResource FluentBorderlessButtonStyle}"
                                            Click="OnOpenBrainFolderClicked"
                                            Tag="{Binding ConversationId}"
                                            Margin="0,0,2,0"
                                            Padding="7,5">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" Opacity="0.78"/>
                                    </Button>
                                    <Button ToolTip="{DynamicResource ProjectConversations_DeleteTip}"
                                            Style="{StaticResource FluentBorderlessButtonStyle}"
                                            Click="OnDeleteItemClicked"
                                            Tag="{Binding ConversationId}"
                                            Padding="7,5">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{DynamicResource StatusCriticalBrush}" Opacity="0.85"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Common_Close}" Click="OnCloseClicked" Appearance="Secondary" Padding="16,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
