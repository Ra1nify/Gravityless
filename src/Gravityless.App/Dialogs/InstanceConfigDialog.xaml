<ui:FluentWindow x:Class="Gravityless.App.Dialogs.InstanceConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Instances_ConfigDialogTitle}" 
        Width="520"
        SizeToContent="Height"
        MinHeight="440"
        MaxHeight="760"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{DynamicResource Instances_ConfigDialogTitle}" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,24,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Instances_ConfigBasicHeader}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource FluentSubSurfaceStyle}" Padding="12,8" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Instances_IdLabel}" FontSize="11" Opacity="0.6"/>
                            <TextBlock x:Name="InstanceIdText" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button AutomationProperties.AutomationId="CopyInstanceIdBtn"
                                AutomationProperties.Name="{DynamicResource Common_Copy}"
                                x:Name="CopyInstanceIdBtn"
                                Grid.Column="1"
                                Style="{StaticResource FluentBorderlessButtonStyle}"
                                Click="OnCopyInstanceIdClicked"
                                Padding="7,5"
                                ToolTip="{DynamicResource Common_Copy}"
                                VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="15" Opacity="0.78"/>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Instances_ConfigNameLabel}" FontSize="12" Opacity="0.75" Margin="0,0,0,5"/>
                <ui:TextBox AutomationProperties.AutomationId="InstanceNameBox" x:Name="InstanceNameBox" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Instances_ConfigAccountLabel}" FontSize="12" Opacity="0.75" Margin="0,0,0,5"/>
                <ComboBox AutomationProperties.AutomationId="InstanceAccountCombo" x:Name="AccountCombo" DisplayMemberPath="Email" SelectedValuePath="Id" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Instances_ConfigProjectsLabel}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="SelectedProjectsCountText" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>

                <ui:TextBox AutomationProperties.AutomationId="InstanceProjectSearchBox"
                            x:Name="ProjectSearchBox"
                            PlaceholderText="{DynamicResource Instances_ConfigProjectSearchPlaceholder}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            ClearButtonEnabled="True"
                            TextChanged="OnProjectSearchTextChanged"
                            Margin="0,0,0,8"/>

                <Border x:Name="ProjectsListBorder"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource FluentControlCornerRadius}"
                        MaxHeight="160"
                        Margin="0,0,0,16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProjectsCheckList" Margin="8,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="OnProjectCheckChanged"
                                                  Unchecked="OnProjectCheckChanged"
                                                  Margin="4,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="ProjectsEmptyHint"
                                   Text="{DynamicResource Instances_ConfigNoProjectsHint}"
                                   FontSize="12" Opacity="0.55"
                                   Padding="12,10"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <ui:SymbolIcon Symbol="Share24" FontSize="15" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Instances_ConfigSharedHeader}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Instances_ShareSkillsTip}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Instances_ConfigSkillsDesc}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ShareSkillsSwitch" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.35"/>

                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Instances_SharePluginsTip}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Instances_ConfigPluginsDesc}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="SharePluginsSwitch" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.35"/>

                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Instances_ShareMcpTip}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{DynamicResource Instances_ConfigMcpDesc}" FontSize="11.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ShareMcpSwitch" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <ui:Button AutomationProperties.AutomationId="OpenSandboxButton"
                           x:Name="OpenSandboxButton"
                           Content="{DynamicResource Instances_OpenSandboxFolderBtn}"
                           Click="OnOpenSandboxClicked"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                           HorizontalAlignment="Stretch"
                           Padding="12,8"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button AutomationProperties.AutomationId="InstanceConfigCancelBtn" Content="{DynamicResource Common_Cancel}" Click="OnCancelClicked" Appearance="Secondary" Margin="0,0,8,0" Width="80"/>
                <ui:Button AutomationProperties.AutomationId="InstanceConfigSaveBtn" x:Name="SaveButton" Content="{DynamicResource Common_Save}" Click="OnSaveClicked" Appearance="Primary" Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
