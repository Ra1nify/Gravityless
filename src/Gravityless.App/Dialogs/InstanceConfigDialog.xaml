<ui:FluentWindow x:Class="Gravityless.App.Dialogs.InstanceConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Instances_ConfigDialogTitle}" 
        Width="520"
        SizeToContent="Height"
        MinHeight="440"
        MaxHeight="760"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Grid Margin="0,0,0,16" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar" Grid.Row="0" Title="{DynamicResource Instances_ConfigDialogTitle}" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,10,24,16">
            <StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{DynamicResource Instances_ConfigBasicHeader}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                  </StackPanel>
                
                <ui:Card Margin="0,0,0,12" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Instances_IdLabel}" FontSize="11" Opacity="0.6"/>
                            <TextBlock x:Name="InstanceIdText" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:Button x:Name="CopyInstanceIdBtn" Grid.Column="1" Click="OnCopyInstanceIdClicked" Appearance="Secondary" Padding="7,4" Icon="{ui:SymbolIcon Symbol=Copy24}" ToolTip="{DynamicResource Common_Copy}"/>
                    </Grid>
                </ui:Card>

                <TextBlock Text="{DynamicResource Instances_ConfigNameLabel}" FontSize="12" Opacity="0.75" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="InstanceNameBox" Margin="0,0,0,12"/>

                <TextBlock Text="{DynamicResource Instances_ConfigAccountLabel}" FontSize="12" Opacity="0.75" Margin="0,0,0,4"/>
                <ComboBox x:Name="AccountCombo" DisplayMemberPath="Email" SelectedValuePath="Id" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="授权挂载的项目与记忆库 (可多选):" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="SelectedProjectsCountText" Text="已选 0 项 (共 0 项)" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>

                <ui:TextBox x:Name="ProjectSearchBox" 
                            PlaceholderText="搜索项目名称、本地路径或 ID..." 
                            Icon="{ui:SymbolIcon Symbol=Search24}" 
                            ClearButtonEnabled="True" 
                            TextChanged="OnProjectSearchTextChanged" 
                            Margin="0,0,0,8"/>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="160" Margin="0,0,0,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProjectsCheckList" Margin="8,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayText}" 
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Checked="OnProjectCheckChanged" 
                                              Unchecked="OnProjectCheckChanged" 
                                              Margin="4,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Separator Margin="0,4,0,16" Opacity="0.2"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <ui:SymbolIcon Symbol="Share24" FontSize="16" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{DynamicResource Instances_ConfigSharedHeader}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                  </StackPanel>
                <TextBlock Text="{DynamicResource Instances_ConfigSharedDesc}" FontSize="12" Opacity="0.65" Margin="0,0,0,12"/>

                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Instances_ShareSkillsTip}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Instances_ConfigSkillsDesc}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="ShareSkillsSwitch" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Instances_SharePluginsTip}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Instances_ConfigPluginsDesc}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="SharePluginsSwitch" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Instances_ShareMcpTip}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Instances_ConfigMcpDesc}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" x:Name="ShareMcpSwitch" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <Separator x:Name="SandboxSeparator" Margin="0,4,0,16" Opacity="0.2"/>

                <ui:Button x:Name="OpenSandboxButton" 
                           Content="{DynamicResource Instances_OpenSandboxFolderBtn}" 
                           Click="OnOpenSandboxClicked" 
                           Appearance="Secondary" 
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                           HorizontalAlignment="Stretch" 
                           Padding="12,8"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Common_Cancel}" Click="OnCancelClicked" Appearance="Secondary" Margin="0,0,10,0" Width="80"/>
                <ui:Button x:Name="SaveButton" Content="{DynamicResource Common_Save}" Click="OnSaveClicked" Appearance="Primary" Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
