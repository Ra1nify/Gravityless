                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Proxy_ParamsCardTitle}" Style="{StaticResource FluentSectionTitleStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Proxy_ProtocolLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
                                        <ComboBox AutomationProperties.AutomationId="ProxyProtocolCombo" Grid.Column="1" x:Name="ProxyProtocolCombo" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="SOCKS5"/>
                                            <ComboBoxItem Content="HTTP"/>
                                            <ComboBoxItem Content="HTTPS"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Proxy_HostLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
