<ui:FluentWindow x:Class="Gravityless.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctrl="clr-namespace:Gravityless.App.Controls"
        Title="{DynamicResource App_Title}" 
        Height="840" Width="1260"
        MinHeight="680" MinWidth="1020"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- View models expose bool; visibility is converted here -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PaneFooterTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="Margin" Value="1,0,8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Requires ScrollViewer.HorizontalScrollBarVisibility=Disabled; otherwise star columns measure at infinity -->
        <Style x:Key="StretchRowItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootWindowGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" ShowMaximize="True" ShowMinimize="True"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0" x:Name="RootNav" 
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               IsPaneOpen="True"
                               IsTopSeparatorVisible="False"
                               IsFooterSeparatorVisible="False"
                               OpenPaneLength="220"
                               CompactPaneLength="56">

                <!-- Sidebar collapse toggle -->
                <ui:NavigationView.PaneHeader>
                    <Button AutomationProperties.AutomationId="PaneToggleButton"
                            AutomationProperties.Name="{DynamicResource Nav_ToggleTip}"
                            x:Name="PaneToggleButton"
                            Style="{StaticResource FluentBorderlessButtonStyle}"
                            Width="40" Height="40" Margin="0,0,0,6"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnPaneToggleClicked"
                            ToolTip="{DynamicResource Nav_ToggleTip}">
                        <ui:SymbolIcon Symbol="Navigation24" FontSize="16"/>
                    </Button>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavOverview" Tag="overview" Click="OnNavItemClicked" IsActive="True"
                                           Content="{DynamicResource Nav_Overview}"
                                           Icon="{ui:SymbolIcon Symbol=Home24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavInstances" Tag="instances" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Instances}"
                                           Icon="{ui:SymbolIcon Symbol=Desktop24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavProjects" Tag="projects" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Projects}"
                                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavTools" Tag="tools" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Tools}"
                                           Icon="{ui:SymbolIcon Symbol=Apps24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavProxy" Tag="proxy" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Proxy}"
                                           Icon="{ui:SymbolIcon Symbol=Globe24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavAccounts" Tag="accounts" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Accounts}"
                                           Icon="{ui:SymbolIcon Symbol=PeopleTeam24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavAppearance" Tag="appearance" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Appearance}"
                                           Icon="{ui:SymbolIcon Symbol=Color24}"/>

                </ui:NavigationView.MenuItems>

                <!-- Sidebar runtime status rows -->
                <ui:NavigationView.PaneFooter>
                    <StackPanel Margin="0,0,0,8">
                        <Button x:Name="CoreStatusBadgeContainer"
                                Style="{StaticResource FluentBorderlessButtonStyle}"
                                Height="36" Margin="0,1,0,1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Click="OnSidebarCoreClicked"
                                ToolTip="{DynamicResource Sidebar_CoreTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="CoreStatusDot" Grid.Column="0" Width="6" Height="6"
                                         Fill="{DynamicResource StatusNeutralBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="SidebarCoreVersionText"
                                           Style="{StaticResource PaneFooterTextStyle}"
                                           Text="{DynamicResource Sidebar_CoreChecking}"/>
                            </Grid>
                        </Button>

                        <Button x:Name="DaemonStatusBadgeContainer"
                                Style="{StaticResource FluentBorderlessButtonStyle}"
                                Height="36" Margin="0,1,0,1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Click="OnSidebarDaemonClicked"
                                ToolTip="{DynamicResource Sidebar_DaemonTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="DaemonStatusDot" Grid.Column="0" Width="6" Height="6"
                                         Fill="{DynamicResource StatusSuccessBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="SidebarDaemonPortText"
                                           Style="{StaticResource PaneFooterTextStyle}"
                                           Text="{DynamicResource Sidebar_DaemonStarting}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <Grid Grid.Column="1" Margin="24,14,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="PageHeaderTitle" Style="{StaticResource FluentPageTitleStyle}" Text="{DynamicResource PageHeader_OverviewTitle}"/>
                    <TextBlock x:Name="PageHeaderSubtitle" Style="{StaticResource FluentCaptionStyle}" Text="{DynamicResource PageHeader_OverviewSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                
                <Grid x:Name="OverviewView" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- App identity, update check, and environment summary -->
                            <ui:Card Margin="0,0,0,14" Padding="20,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image x:Name="AppLogoImage" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Gravityless" Style="{StaticResource FluentSubtitleStyle}" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource FluentBadgeBorderStyle}"
                                                        Padding="6,2" Margin="10,0,0,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock x:Name="AppVersionText" FontSize="11" FontWeight="SemiBold" Opacity="0.85"/>
                                                </Border>
                                                <ui:ProgressRing x:Name="AppUpdateProgressRing"
                                                                 Width="14" Height="14"
                                                                 IsIndeterminate="True"
                                                                 Margin="8,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="Collapsed"/>
                                                <Border x:Name="AppUpdateStatusTag"
                                                        Style="{StaticResource FluentBadgeBorderStyle}"
                                                        Padding="7,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                    <TextBlock x:Name="AppUpdateStatusTagText"
                                                               FontSize="10.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="RepoUrlText" Margin="0,4,0,0" FontSize="12" Opacity="0.55" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button AutomationProperties.AutomationId="OpenRepoButton" x:Name="OpenRepoButton"
                                                       Content="{DynamicResource Overview_OpenRepoBtn}"
                                                       Click="OnOpenRepoClicked"
                                                       Appearance="Secondary" Margin="0,0,8,0"
                                                       CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                       Icon="{ui:SymbolIcon Symbol=Code24}"/>
                                            <ui:Button AutomationProperties.AutomationId="AppUpdateButton" x:Name="AppUpdateButton"
                                                       Content="{DynamicResource Overview_AppUpdateBtn}"
                                                       Click="OnCheckAppUpdateClicked"
                                                       Appearance="Secondary"
                                                       CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                            <ui:Button AutomationProperties.AutomationId="AppUpdateInstallButton" x:Name="AppUpdateInstallButton"
                                                       Content="{DynamicResource Overview_AppUpdateInstallBtn}"
                                                       Click="OnDownloadAppUpdateClicked"
                                                       Appearance="Primary" Margin="8,0,0,0"
                                                       CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                       Visibility="Collapsed"
                                                       Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.55"/>

                                    <!-- Environment summary -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Overview_SummaryCoreLabel}" Style="{StaticResource FluentCaptionStyle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="OverviewCoreSummaryDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource StatusNeutralBrush}"/>
                                                <TextBlock x:Name="OverviewCoreSummaryText" Style="{StaticResource FluentBodyStrongStyle}" VerticalAlignment="Center"
                                                           Text="{DynamicResource Common_Checking}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Margin="16,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.55"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Overview_SummaryDaemonLabel}" Style="{StaticResource FluentCaptionStyle}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                <Ellipse x:Name="OverviewDaemonSummaryDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource StatusSuccessBrush}"/>
                                                <TextBlock x:Name="OverviewDaemonSummaryText" Style="{StaticResource FluentBodyStrongStyle}" VerticalAlignment="Center"
                                                           Text="{DynamicResource Sidebar_DaemonStarting}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="3" Width="1" Margin="16,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.55"/>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{DynamicResource Overview_SummaryWorkspaceLabel}" Style="{StaticResource FluentCaptionStyle}"/>
                                            <TextBlock x:Name="OverviewWorkspaceSummaryText" Style="{StaticResource FluentBodyStrongStyle}"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- App update status and progress -->
                                    <ui:InfoBar x:Name="AppUpdateInfoBar"
                                                Severity="Informational"
                                                Title="{DynamicResource Overview_AppUpdateStatusTitle}"
                                                IsOpen="False"
                                                IsClosable="True"
                                                Margin="0,12,0,0"/>

                                    <Border x:Name="AppUpdateProgressPanel"
                                            Style="{StaticResource FluentSubSurfaceStyle}"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="AppUpdateProgressLabel" Style="{StaticResource FluentCaptionStyle}" Opacity="0.85" Margin="0,0,0,6"/>
                                            <ProgressBar x:Name="AppUpdateProgressBar" Height="4" Minimum="0" Maximum="100"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>

                            <!-- Managed Antigravity core lifecycle -->
                            <ui:Card Padding="20,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Overview_CoreSectionTitle}" Style="{StaticResource FluentSectionTitleStyle}"/>
                                                <TextBlock Text="{DynamicResource Overview_CoreSectionDesc}" Style="{StaticResource FluentCaptionStyle}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="CoreStatusBadgeBorder" Style="{StaticResource FluentBadgeBorderStyle}"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Name="CoreStatusBadgeText" Text="{DynamicResource Common_Checking}" FontWeight="SemiBold" FontSize="11.5"/>
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Margin="0,14,0,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.55"/>

                                    <!-- Installed core version and update status -->
                                    <Grid Margin="0,12,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource CoreStatus_VersionLabel}" Style="{StaticResource FluentCaptionStyle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ManagedCoreVersionText" Text="{DynamicResource Common_Checking}" Style="{StaticResource FluentBodyStrongStyle}" VerticalAlignment="Center"/>
                                            <ui:ProgressRing x:Name="CoreUpdateProgressRing"
                                                             Width="14" Height="14"
                                                             IsIndeterminate="True"
                                                             Margin="8,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Visibility="Collapsed"/>
                                            <Border x:Name="CoreUpdateStatusTag"
                                                    Style="{StaticResource FluentBadgeBorderStyle}"
                                                    Padding="7,2" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="CoreUpdateStatusTagText"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel x:Name="CoreRemoteLinkActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button x:Name="CopyDownloadLinkBtn"
                                                    Style="{StaticResource FluentBorderlessButtonStyle}"
                                                    Padding="7,5" Margin="0,0,4,0"
                                                    Click="OnCopyDownloadLinkClicked"
                                                    ToolTip="{DynamicResource CloudUpdate_CopyLinkTip}"
                                                    AutomationProperties.Name="{DynamicResource CloudUpdate_CopyLinkTip}">
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="15" Opacity="0.75"/>
                                            </Button>
                                            <Button x:Name="OpenDownloadLinkBtn"
                                                    Style="{StaticResource FluentBorderlessButtonStyle}"
                                                    Padding="7,5"
                                                    Click="OnDownloadLinkClicked"
                                                    ToolTip="{DynamicResource CloudUpdate_OpenLinkTip}"
                                                    AutomationProperties.Name="{DynamicResource CloudUpdate_OpenLinkTip}">
                                                <ui:SymbolIcon Symbol="Open24" FontSize="15" Opacity="0.75"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.35"/>

                                    <!-- Core installation directory -->
                                    <Grid Margin="0,12,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource CoreStatus_PathLabel}" Style="{StaticResource FluentCaptionStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ManagedCorePathText" Text="-" FontSize="12" FontFamily="Consolas" Opacity="0.78"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Grid.Column="2" x:Name="CorePathButton"
                                                Style="{StaticResource FluentBorderlessButtonStyle}"
                                                Padding="7,5" Visibility="Collapsed"
                                                AutomationProperties.AutomationId="OverviewCorePath"
                                                AutomationProperties.Name="{DynamicResource CoreStatus_PathTooltip}"
                                                Click="OnCorePathRowClicked" ToolTip="{DynamicResource CoreStatus_PathTooltip}">
                                            <ui:SymbolIcon Symbol="Open24" FontSize="15" Opacity="0.75"/>
                                        </Button>
                                    </Grid>

                                    <!-- Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <ui:Button AutomationProperties.AutomationId="DownloadInstallButton" x:Name="DownloadInstallButton"
                                                   Content="{DynamicResource CloudUpdate_InstallBtn}"
                                                   Click="OnDownloadAndInstallClicked"
                                                   Appearance="Primary" IsEnabled="False" Margin="0,0,8,0"
                                                   CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"/>
                                        <ui:Button AutomationProperties.AutomationId="CheckUpdateButton" x:Name="CheckUpdateButton"
                                                   Content="{DynamicResource CloudUpdate_CheckBtn}"
                                                   Click="OnCheckUpdateClicked"
                                                   Appearance="Secondary" Margin="0,0,8,0"
                                                   CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                        <ui:Button AutomationProperties.AutomationId="UninstallCoreButton" x:Name="UninstallCoreButton"
                                                   Content="{DynamicResource CoreStatus_UninstallBtn}"
                                                   Click="OnUninstallCoreClicked"
                                                   Appearance="Secondary" Visibility="Collapsed"
                                                   CornerRadius="{StaticResource FluentControlCornerRadius}"
                                                   Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                    </StackPanel>

                                    <!-- Core operation status and progress -->
                                    <ui:InfoBar x:Name="UpdateInfoBar"
                                                Severity="Informational"
                                                Title="{DynamicResource CloudUpdate_StatusTitle}"
                                                IsOpen="False"
                                                IsClosable="True"
                                                Margin="0,12,0,0"/>

                                    <Border x:Name="InstallProgressPanel"
                                            Style="{StaticResource FluentSubSurfaceStyle}"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <ProgressBar x:Name="InstallProgressBar" Height="4"/>
                                            <TextBlock x:Name="InstallProgressLabel" Style="{StaticResource FluentCaptionStyle}" Opacity="0.85" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="InstancesView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:Button AutomationProperties.AutomationId="InstancesNewBtn" Content="{DynamicResource Instances_NewBtn}" Click="OnCreateInstanceClicked" Appearance="Primary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Add24}"/>
                        <ui:Button AutomationProperties.AutomationId="InstancesRefreshBtn" Content="{DynamicResource Instances_RefreshBtn}" Click="OnRefreshInstancesClicked" Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                        <ui:Button AutomationProperties.AutomationId="InstancesStopAllBtn" Content="{DynamicResource Instances_StopAllBtn}" Click="OnStopAllInstancesClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Stop24}"/>
                    </StackPanel>

                    <ListView AutomationProperties.AutomationId="InstancesListView" Grid.Row="1" x:Name="InstancesListView"
                              Focusable="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource StretchRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource FluentBodyStrongStyle}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource FluentBadgeBorderStyle}"
                                                        Padding="6,1" Margin="8,0,0,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShortId}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Padding="7,2" Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource FluentBadgeBorderStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessFillSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusNeutralBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusNeutralBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BoundAccountText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.65" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BoundProjectText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.65" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ui:Button AutomationProperties.AutomationId="InstanceRowLaunch" Content="{DynamicResource Instances_Launch}"
                                                       Click="OnStartInstanceClicked"
                                                       Tag="{Binding Id}"
                                                       Appearance="Secondary"
                                                       Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}"
                                                       Margin="0,0,6,0"
                                                       Padding="12,5"
