                                                SmallChange="0.05" LargeChange="0.2"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseFreqChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseFreqLabel" Text="0.85" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseTintLabel}" VerticalAlignment="Center" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseTintHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseTintSlider" Grid.Column="1" x:Name="NoiseTintSlider"
                                                Minimum="0" Maximum="1" Value="0.28"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseTintChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseTintLabel" Text="28%" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseBaseLabel}" VerticalAlignment="Center" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseBaseHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseBaseSlider" Grid.Column="1" x:Name="NoiseBaseSlider"
                                                Minimum="0" Maximum="1" Value="0.35"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseBaseChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseBaseLabel" Text="35%" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                </StackPanel>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,16" Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="Translate24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Language_UnifiedCardTitle}" FontWeight="Bold" FontSize="18"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Language_UnifiedCardDesc}" 
                                               TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16" LineHeight="20" FontSize="13"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Language_SelectLabel}" VerticalAlignment="Center" Opacity="0.85"/>
                                        <ComboBox AutomationProperties.AutomationId="LanguageCombo" Grid.Column="1" x:Name="LanguageCombo" 
                                                  DisplayMemberPath="DisplayName" 
                                                  SelectedValuePath="Id"
                                                  DropDownOpened="OnLanguageComboDropDownOpened"
                                                  SelectionChanged="OnLanguageSelectionChanged"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_AccentInteractionLabel}" VerticalAlignment="Center" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_AccentInteractionHint}"/>
                                        <CheckBox AutomationProperties.AutomationId="AccentInteractionCheck" Grid.Column="1" x:Name="AccentInteractionCheck"
                                                  Content="{DynamicResource Appearance_AccentInteractionContent}"
                                                  VerticalAlignment="Center"
                                                  Checked="OnAccentInteractionChanged" Unchecked="OnAccentInteractionChanged"/>
                                    </Grid>

                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>


            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
