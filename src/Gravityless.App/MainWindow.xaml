                                                        Style="{StaticResource FluentBorderlessButtonStyle}"
                                                        Click="OnToolDetailsClicked" Tag="{Binding}"
                                                        Padding="8,5" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Opacity="0.75" Margin="0,0,5,0" VerticalAlignment="Center"/>
