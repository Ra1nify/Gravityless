                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12" Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <ui:SymbolIcon Symbol="Password24" FontSize="16" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Proxy_AuthCardTitle}" Style="{StaticResource FluentSectionTitleStyle}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Proxy_UsernameLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
                                        <ui:TextBox AutomationProperties.AutomationId="ProxyUsernameBox" Grid.Column="1" x:Name="ProxyUsernameBox"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Proxy_PasswordLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
                                        <ui:PasswordBox AutomationProperties.AutomationId="ProxyPasswordBox" Grid.Column="1" x:Name="ProxyPasswordBox"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12" Padding="18,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button AutomationProperties.AutomationId="ProxyTestBtn" Content="{DynamicResource Proxy_TestBtn}" Click="OnTestProxyClicked" Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=NetworkCheck24}"/>
                                        <ui:Button AutomationProperties.AutomationId="ProxySaveBtn" Content="{DynamicResource Proxy_SaveBtn}" Click="OnSaveProxyClicked" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Checkmark24}"/>
                                    </StackPanel>

                                    <!-- Connectivity report. Row 0 spans the value columns because a
                                         run has a single egress region; rows 1 and 2 are per probe. -->
                                    <Grid x:Name="ProxyTestResultGrid" Margin="0,14,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="ProxyRegionLabel" Grid.Row="0" Grid.Column="0"
                                                   Text="{DynamicResource Proxy_RegionRow}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.72"
                                                   VerticalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="ProxyRegionValue" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,6"/>

                                        <TextBlock x:Name="ProxyGeminiLabel" Grid.Row="1" Grid.Column="0"
                                                   Text="Gemini" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.72"
                                                   VerticalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ProxyGeminiStatus" Grid.Row="1" Grid.Column="1"
                                                   FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ProxyGeminiLatency" Grid.Row="1" Grid.Column="2"
                                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="ProxyGeminiReason" Grid.Row="1" Grid.Column="3"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.65" TextAlignment="Left" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="ProxyAntigravityLabel" Grid.Row="2" Grid.Column="0"
                                                   Text="Antigravity" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.72"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ProxyAntigravityStatus" Grid.Row="2" Grid.Column="1"
                                                   FontSize="13" FontWeight="Bold" TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ProxyAntigravityLatency" Grid.Row="2" Grid.Column="2"
                                                   FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ProxyAntigravityReason" Grid.Row="2" Grid.Column="3"
                                                   FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.65" TextAlignment="Left" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AccountsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button AutomationProperties.AutomationId="AccountsCaptureBtn" Content="{DynamicResource Accounts_CaptureBtn}" Click="OnCaptureAccountClicked" Appearance="Primary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Add24}"/>
                                <ui:Button AutomationProperties.AutomationId="AccountsRefreshAllTokensBtn" Content="{DynamicResource Accounts_RefreshAllTokensBtn}" Click="OnRefreshAllTokensClicked" Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                <ui:Button AutomationProperties.AutomationId="AccountsUnlockAllBtn" Content="{DynamicResource Accounts_UnlockAllBtn}" Click="OnUnlockAllAccountsClicked" Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=LockOpen24}"/>
                                <ui:Button AutomationProperties.AutomationId="AccountsVerifyBtn" Content="{DynamicResource Accounts_VerifyBtn}" Click="OnVerifyCredentialsClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ShieldCheckmark24}"/>
                            </StackPanel>
                            <ctrl:PageStatusStrip Grid.Column="1" x:Name="AccountsStatusStrip" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <ListView AutomationProperties.AutomationId="AccountsListView" Grid.Row="1" x:Name="AccountsListView"
                              Focusable="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource StretchRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,0,8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrimaryName}" Style="{StaticResource FluentBodyStrongStyle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <Border HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Style="{StaticResource FluentBadgeBorderStyle}"
                                                    Padding="6,1"
                                                    Background="{DynamicResource BrandAccentFillStrongerBrush}"
                                                    Visibility="{Binding ShowTierBadge, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TierBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrandAccentTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0" ClipToBounds="True">
                                            <!-- Star column lets the long quota summary ellipsize -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusCautionBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusCautionBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding QuotaSummaryText}" FontSize="11.5" Opacity="0.88" Foreground="{DynamicResource BrandAccentTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Visibility="{Binding ShowQuotaSummary, Converter={StaticResource BoolToVisibility}}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <TextBlock Text="{Binding BoundInstanceSubtitle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.62" Margin="12,3,0,0" Visibility="{Binding ShowBoundInstanceSubtitle, Converter={StaticResource BoolToVisibility}}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ui:Button AutomationProperties.AutomationId="AccountRowRefreshToken" AutomationProperties.Name="{DynamicResource Accounts_RefreshTokenTip}" ToolTip="{DynamicResource Accounts_RefreshTokenTip}" 
                                                       Click="OnRefreshTokenClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary" 
                                                       Margin="0,0,8,0"
                                                       Padding="8,5"
                                                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                            <ui:Button AutomationProperties.AutomationId="AccountRowDetails" AutomationProperties.Name="{DynamicResource Accounts_DetailsTip}" ToolTip="{DynamicResource Accounts_DetailsTip}" 
                                                       Click="OnAccountDetailsClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary" 
                                                       Margin="0,0,8,0"
                                                       Padding="8,5"
                                                       Icon="{ui:SymbolIcon Symbol=Info24}"/>
                                            <ui:Button AutomationProperties.AutomationId="AccountRowUnlock" Content="{DynamicResource Accounts_UnlockBtn}" 
                                                       Click="OnUnlockAccountClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Caution" 
                                                       Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibility}}" 
                                                       Margin="0,0,8,0"
                                                       Padding="10,5"
                                                       Icon="{ui:SymbolIcon Symbol=LockOpen24}"/>
                                            <ui:Button AutomationProperties.AutomationId="AccountRowDelete" AutomationProperties.Name="{DynamicResource Common_Delete}" ToolTip="{DynamicResource Common_Delete}" 
                                                       Click="OnDeleteAccountClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary"
                                                       Padding="8,5"
                                                       Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="AppearanceView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>

                            <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12" Padding="20,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ColorBackground24" FontSize="17" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Appearance_MicaCardTitle}" Style="{StaticResource FluentSectionTitleStyle}" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Appearance_MicaDesc}"
                                               Style="{StaticResource FluentCaptionStyle}"
                                               Margin="0,6,0,16" LineHeight="19"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_ThemeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"/>
                                        <ComboBox AutomationProperties.AutomationId="ThemeModeCombo" Grid.Column="1" x:Name="ThemeModeCombo"
                                                  SelectionChanged="OnThemeModeChanged"
                                                  SelectedIndex="0">
                                            <ComboBoxItem x:Name="ThemeAutoItem" Tag="auto" Content="{DynamicResource Appearance_ThemeAuto}"/>
                                            <ComboBoxItem x:Name="ThemeLightItem" Tag="light" Content="{DynamicResource Appearance_ThemeLight}"/>
                                            <ComboBoxItem x:Name="ThemeDarkItem" Tag="dark" Content="{DynamicResource Appearance_ThemeDark}"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_MaterialLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"/>
                                        <ComboBox AutomationProperties.AutomationId="BackdropMaterialCombo" Grid.Column="1" x:Name="BackdropMaterialCombo"
                                                  SelectionChanged="OnBackdropMaterialChanged"
                                                  SelectedIndex="0">
                                            <ComboBoxItem x:Name="MaterialNoneItem" Tag="none" Content="{DynamicResource Appearance_MaterialNone}" ToolTip="{DynamicResource Appearance_MaterialNoneHint}"/>
                                            <ComboBoxItem x:Name="MaterialMicaItem" Tag="mica" Content="{DynamicResource Appearance_MaterialMica}"/>
                                            <ComboBoxItem x:Name="MaterialTabbedItem" Tag="tabbed" Content="{DynamicResource Appearance_MaterialTabbed}"/>
                                            <ComboBoxItem x:Name="MaterialAcrylicItem" Tag="acrylic" Content="{DynamicResource Appearance_MaterialAcrylic}"/>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_AccentInteractionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_AccentInteractionHint}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ToggleSwitch AutomationProperties.AutomationId="AccentInteractionCheck"
                                                             AutomationProperties.Name="{DynamicResource Appearance_AccentInteractionLabel}"
                                                             x:Name="AccentInteractionCheck"
                                                             VerticalAlignment="Center"
                                                             Checked="OnAccentInteractionChanged" Unchecked="OnAccentInteractionChanged"/>
                                            <TextBlock Text="{DynamicResource Appearance_AccentInteractionContent}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.72" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.35" Margin="0,2,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_OpacityLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"/>
                                        <Slider AutomationProperties.AutomationId="MicaOpacitySlider" Grid.Column="1" x:Name="MicaOpacitySlider"
                                                Minimum="0.00" Maximum="1.00" Value="0.28"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnMicaOpacityChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="MicaOpacityLabel" Text="28%" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseAlphaLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseAlphaHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseAlphaSlider" Grid.Column="1" x:Name="NoiseAlphaSlider"
                                                Minimum="0" Maximum="1" Value="0.55"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseAlphaChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseAlphaLabel" Text="55%" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseFreqLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseFreqHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseFreqSlider" Grid.Column="1" x:Name="NoiseFreqSlider"
                                                Minimum="0.5" Maximum="2.0" Value="0.85"
                                                SmallChange="0.05" LargeChange="0.2"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseFreqChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseFreqLabel" Text="0.85" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseTintLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseTintHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseTintSlider" Grid.Column="1" x:Name="NoiseTintSlider"
                                                Minimum="0" Maximum="1" Value="0.28"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseTintChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseTintLabel" Text="28%" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Appearance_NoiseBaseLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"
                                                   ToolTip="{DynamicResource Appearance_NoiseBaseHint}"/>
                                        <Slider AutomationProperties.AutomationId="NoiseBaseSlider" Grid.Column="1" x:Name="NoiseBaseSlider"
                                                Minimum="0" Maximum="1" Value="0.35"
                                                SmallChange="0.01" LargeChange="0.05"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="OnNoiseBaseChanged"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="NoiseBaseLabel" Text="35%" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border CornerRadius="{StaticResource FluentCardCornerRadius}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12" Padding="20,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Translate24" FontSize="17" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Language_UnifiedCardTitle}" Style="{StaticResource FluentSectionTitleStyle}" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Language_UnifiedCardDesc}"
                                               Style="{StaticResource FluentCaptionStyle}"
                                               Margin="0,0,0,14" LineHeight="19"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="240"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Language_SelectLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85"/>
                                        <ComboBox AutomationProperties.AutomationId="LanguageCombo" Grid.Column="1" x:Name="LanguageCombo"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  DropDownOpened="OnLanguageComboDropDownOpened"
                                                  SelectionChanged="OnLanguageSelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
