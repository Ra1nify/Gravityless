                                        <TextBlock Grid.Column="2" Text="{DynamicResource Proxy_PortLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
                                        <ui:TextBox AutomationProperties.AutomationId="ProxyPortBox" Grid.Column="3" x:Name="ProxyPortBox" Text="2952"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Proxy_BypassLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.78"/>
