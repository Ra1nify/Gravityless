                                <ui:Button AutomationProperties.AutomationId="ToolsEditMcpConfigBtn" Content="{DynamicResource Tools_EditMcpConfigBtn}" Click="OnEditMcpConfigFileClicked" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentEdit24}" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Tools_McpPathHint}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.58" FontSize="11.5" VerticalAlignment="Center"/>
