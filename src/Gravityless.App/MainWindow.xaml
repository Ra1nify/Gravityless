                                    </StackPanel>
                                    <RadioButton AutomationProperties.AutomationId="ProxyDirectRadio" x:Name="ProxyDirectRadio" Content="{DynamicResource Proxy_ModeDirect}" GroupName="ProxyMode" Margin="0,0,0,8" Checked="OnProxyModeRadioChanged"/>
                                    <RadioButton AutomationProperties.AutomationId="ProxySystemRadio" x:Name="ProxySystemRadio" Content="{DynamicResource Proxy_ModeSystem}" GroupName="ProxyMode" Margin="0,0,0,8" Checked="OnProxyModeRadioChanged"/>
                                    <RadioButton AutomationProperties.AutomationId="ProxyManualRadio" x:Name="ProxyManualRadio" Content="{DynamicResource Proxy_ModeManual}" GroupName="ProxyMode" IsChecked="True" Checked="OnProxyModeRadioChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Shown only when Manual mode is selected -->
                            <Border x:Name="ManualProxyCard"
                                    CornerRadius="{StaticResource FluentCardCornerRadius}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
