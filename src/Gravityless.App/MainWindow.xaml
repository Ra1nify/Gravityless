<ui:FluentWindow x:Class="Gravityless.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctrl="clr-namespace:Gravityless.App.Controls"
        Title="{DynamicResource App_Title}" 
        Height="840" Width="1260"
        MinHeight="680" MinWidth="1020"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!-- View models expose bool; visibility is converted here -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 9px + 1px divider = 54px, matching nav label offset (4 pane + 40 icon + 10 template margin) -->
        <Style x:Key="PaneFooterTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaneFooterDividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Fill" Value="{DynamicResource OverlaySeparatorBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Requires ScrollViewer.HorizontalScrollBarVisibility=Disabled; otherwise star columns measure at infinity -->
        <Style x:Key="StretchRowItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootWindowGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" ShowMaximize="True" ShowMinimize="True"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0" x:Name="RootNav" 
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               IsPaneOpen="True"
                               IsTopSeparatorVisible="False"
                               IsFooterSeparatorVisible="False"
                               OpenPaneLength="220"
                               CompactPaneLength="56">

                <!-- Custom toggle: 40x40 aligns with nav icon column; built-in button margin is fixed -->
                <ui:NavigationView.PaneHeader>
                    <ui:Button AutomationProperties.AutomationId="PaneToggleButton" x:Name="PaneToggleButton" Width="40" Height="40" Padding="0" Margin="0,0,0,6"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Appearance="Transparent" Click="OnPaneToggleClicked"
                               ToolTip="{DynamicResource Nav_ToggleTip}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="14" Height="1.5" Margin="0,0,0,3.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"/>
                            <Rectangle Width="14" Height="1.5" Margin="0,0,0,3.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"/>
                            <Rectangle Width="14" Height="1.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}"/>
                        </StackPanel>
                    </ui:Button>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavOverview" Tag="overview" Click="OnNavItemClicked" IsActive="True"
                                           Content="{DynamicResource Nav_Overview}"
                                           Icon="{ui:SymbolIcon Symbol=Home24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavInstances" Tag="instances" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Instances}"
                                           Icon="{ui:SymbolIcon Symbol=Desktop24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavProjects" Tag="projects" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Projects}"
                                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavTools" Tag="tools" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Tools}"
                                           Icon="{ui:SymbolIcon Symbol=Apps24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavProxy" Tag="proxy" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Proxy}"
                                           Icon="{ui:SymbolIcon Symbol=Globe24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavAccounts" Tag="accounts" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Accounts}"
                                           Icon="{ui:SymbolIcon Symbol=PeopleTeam24}"/>
                    <ui:NavigationViewItem AutomationProperties.AutomationId="NavAppearance" Tag="appearance" Click="OnNavItemClicked"
                                           Content="{DynamicResource Nav_Appearance}"
                                           Icon="{ui:SymbolIcon Symbol=Color24}"/>

                </ui:NavigationView.MenuItems>

                <!-- 40px icon column shares the nav icon axis; collapse hides only text, dots never move -->
                <ui:NavigationView.PaneFooter>
                    <StackPanel Margin="0,2,0,6">
                        <!-- MinHeight 40 = nav row height, so the dot keeps its position when text collapses -->
                        <Border x:Name="CoreStatusBadgeContainer" Background="Transparent" MinHeight="40" Margin="0,3,0,3"
                                ToolTip="{DynamicResource Sidebar_CoreTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- -1 offset matches nav icon rendering so centers coincide -->
                                <ui:SymbolIcon x:Name="CoreStatusDot" Grid.Column="0" Symbol="Record16" FontSize="10"
                                               Foreground="{DynamicResource BrandAccentBrush}" Margin="-1,0,0,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Style="{StaticResource PaneFooterDividerStyle}"/>
                                    <TextBlock x:Name="SidebarCoreVersionText" Style="{StaticResource PaneFooterTextStyle}"
                                               Text="{DynamicResource Sidebar_CoreChecking}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="DaemonStatusBadgeContainer" Background="Transparent" MinHeight="40" Margin="0,3,0,3"
                                ToolTip="{DynamicResource Sidebar_DaemonTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="DaemonStatusDot" Grid.Column="0" Symbol="Record16" FontSize="10"
                                               Foreground="{DynamicResource StatusSuccessBrush}" Margin="-1,0,0,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Style="{StaticResource PaneFooterDividerStyle}"/>
                                    <TextBlock x:Name="SidebarDaemonPortText" Style="{StaticResource PaneFooterTextStyle}"
                                               Opacity="0.85" Text="{DynamicResource Sidebar_DaemonStarting}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <Grid Grid.Column="1" Margin="24,14,24,14">
                
                <Grid x:Name="OverviewView" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <ui:Card Margin="0,0,0,16" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image x:Name="AppLogoImage" Height="72" Margin="0,0,20,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Gravityless" FontWeight="Bold" FontSize="22"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{DynamicResource Overview_AppVersionLabel}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AppVersionText" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{DynamicResource Overview_ProjectLabel}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RepoUrlText" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.9"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <ui:Button AutomationProperties.AutomationId="OpenRepoButton" Grid.Column="2" x:Name="OpenRepoButton" Content="{DynamicResource Overview_OpenRepoBtn}"
                                               Click="OnOpenRepoClicked" Appearance="Secondary" VerticalAlignment="Center"
                                               Icon="{ui:SymbolIcon Symbol=Code24}"/>
                                </Grid>
                            </ui:Card>

                            <ui:Card Margin="0,0,0,16" Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Overview_AppUpdateTitle}" FontWeight="Bold" FontSize="18"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Overview_AppUpdateDesc}"
                                               TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14" FontSize="13"/>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button AutomationProperties.AutomationId="AppUpdateButton" x:Name="AppUpdateButton" Content="{DynamicResource Overview_AppUpdateBtn}"
                                                   Appearance="Primary" IsEnabled="False"
                                                   ToolTip="{DynamicResource Overview_AppUpdateComingSoon}"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <ui:Card Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource BrandAccentBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Overview_CoreSectionTitle}" FontWeight="Bold" FontSize="18"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="CoreStatusBadgeBorder" Background="{DynamicResource StatusSuccessFillFaintBrush}" CornerRadius="12" Padding="10,3">
                                            <TextBlock x:Name="CoreStatusBadgeText" Text="{DynamicResource Common_Checking}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 70px label column keeps both rows aligned -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource CoreStatus_VersionLabel}" Opacity="0.65" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ManagedCoreVersionText" Text="{DynamicResource Common_Checking}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Whole row is a Button for keyboard focus and UIA semantics -->
                                    <ui:Button x:Name="CorePathButton" Appearance="Transparent" Padding="0"
                                               HorizontalContentAlignment="Stretch" Margin="0,0,0,12"
                                               AutomationProperties.AutomationId="OverviewCorePath"
                                               AutomationProperties.Name="{DynamicResource CoreStatus_PathTooltip}"
                                               Click="OnCorePathRowClicked" ToolTip="{DynamicResource CoreStatus_PathTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource CoreStatus_PathLabel}" Opacity="0.65" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="ManagedCorePathText" Text="-" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Open24" FontSize="16" Opacity="0.75" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ui:Button>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ui:Button AutomationProperties.AutomationId="CheckUpdateButton" x:Name="CheckUpdateButton" Content="{DynamicResource CloudUpdate_CheckBtn}" Click="OnCheckUpdateClicked" Appearance="Secondary" Margin="0,0,12,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                                        <ui:Button AutomationProperties.AutomationId="DownloadInstallButton" x:Name="DownloadInstallButton" Content="{DynamicResource CloudUpdate_InstallBtn}" Click="OnDownloadAndInstallClicked" Appearance="Primary" IsEnabled="False" Margin="0,0,12,0" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"/>
                                        <ui:Button AutomationProperties.AutomationId="UninstallCoreButton" x:Name="UninstallCoreButton" Content="{DynamicResource CoreStatus_UninstallBtn}" Click="OnUninstallCoreClicked" Appearance="Danger" IsEnabled="False" Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                    </StackPanel>

                                    <TextBlock x:Name="OnlineVersionText" Text="{DynamicResource CloudUpdate_InitialHint}" Margin="0,0,0,8" Opacity="0.85" FontSize="12" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="InstallProgressBar" Height="6" Margin="0,6,0,6" Visibility="Collapsed"/>
                                    <TextBlock x:Name="InstallProgressLabel" Visibility="Collapsed" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="InstancesView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button AutomationProperties.AutomationId="InstancesNewBtn" Content="{DynamicResource Instances_NewBtn}" Click="OnCreateInstanceClicked" Appearance="Primary" Margin="0,0,10,0" Icon="{ui:SymbolIcon Symbol=Add24}"/>
                        <ui:Button AutomationProperties.AutomationId="InstancesRefreshBtn" Content="{DynamicResource Instances_RefreshBtn}" Click="OnRefreshInstancesClicked" Margin="0,0,10,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                        <ui:Button AutomationProperties.AutomationId="InstancesStopAllBtn" Content="{DynamicResource Instances_StopAllBtn}" Click="OnStopAllInstancesClicked" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Stop24}"/>
                    </StackPanel>

                    <ListView AutomationProperties.AutomationId="InstancesListView" Grid.Row="1" x:Name="InstancesListView" 
                              Focusable="False"
                              Background="Transparent" 
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource StretchRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,2,0,6" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DisplayNameWithShortId}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource StatusNeutralBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusNeutralBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PortText}" FontSize="11" Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BoundProjectText}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ui:Button AutomationProperties.AutomationId="InstanceRowLaunch" Content="{DynamicResource Instances_Launch}" 
                                                       Click="OnStartInstanceClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Primary" 
                                                       Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}" 
                                                       Margin="0,0,8,0"
                                                       Padding="12,5"
                                                       Icon="{ui:SymbolIcon Symbol=Play24}"/>
                                            <ui:Button AutomationProperties.AutomationId="InstanceRowStop" Content="{DynamicResource Instances_Stop}" 
                                                       Click="OnStopInstanceClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Danger" 
                                                       Visibility="{Binding ShowStop, Converter={StaticResource BoolToVisibility}}" 
                                                       Margin="0,0,8,0"
                                                       Padding="12,5"
                                                       Icon="{ui:SymbolIcon Symbol=Stop24}"/>
                                            <ui:Button AutomationProperties.AutomationId="InstanceRowConfig" ToolTip="{DynamicResource Instances_ConfigTip}" 
                                                       Click="OnConfigureInstanceClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary" 
                                                       Margin="0,0,8,0"
                                                       Padding="8,5"
                                                       Icon="{ui:SymbolIcon Symbol=Settings24}"/>
                                            <ui:Button AutomationProperties.AutomationId="InstanceRowDelete" ToolTip="{DynamicResource Instances_DeleteTip}" 
                                                       Click="OnDeleteInstanceClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary" 
                                                       Padding="8,5"
                                                       Icon="{ui:SymbolIcon Symbol=Delete24}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="ProjectsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button AutomationProperties.AutomationId="ProjectsImportGeminiBtn" Content="{DynamicResource Projects_ImportGeminiBtn}" Click="OnImportFromGeminiClicked" Appearance="Primary" Margin="0,0,12,0" Icon="{ui:SymbolIcon Symbol=FolderArrowRight24}"/>
                                <ui:Button AutomationProperties.AutomationId="ProjectsRefreshBtn" Content="{DynamicResource Projects_RefreshBtn}" Click="OnRefreshProjectsClicked" Margin="0,0,12,0" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"/>
                            </StackPanel>
                            <ctrl:PageStatusStrip Grid.Column="1" x:Name="ProjectsStatusStrip" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Projects_Desc}" Opacity="0.7" FontSize="12"/>
                    </StackPanel>

                    <ListView AutomationProperties.AutomationId="ProjectsListView" Grid.Row="1" x:Name="ProjectsListView"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource StretchRowItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,4,0,10" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" ClipToBounds="True">
                                            <!-- Name lives in a Grid: a horizontal StackPanel measures at infinity and breaks TextTrimming -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayNameWithShortId}" FontWeight="Bold" FontSize="15"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <ui:Badge Grid.Column="1" Content="{DynamicResource Projects_PathInvalid}" Appearance="Caution" Margin="10,0,6,0" Visibility="{Binding IsPathInvalid, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
                                                <ui:Button AutomationProperties.AutomationId="ProjectRowRelocate" Grid.Column="2" Content="{DynamicResource Projects_RelocateBtn}" Click="OnRelocateProjectPathClicked" Tag="{Binding Id}" Padding="6,2" FontSize="11" Visibility="{Binding IsPathInvalid, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ClipToBounds="True">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource StatusNeutralBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusNeutralBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding BoundInstancesText}" Foreground="{DynamicResource BrandAccentTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding HasBoundInstances, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding ConvoCountText}" FontSize="11" Opacity="0.8" Foreground="{DynamicResource BrandAccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding LastActiveText}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ui:Button AutomationProperties.AutomationId="ProjectRowConversations" Content="{DynamicResource Projects_ConversationsBtn}"
                                                       ToolTip="{DynamicResource Projects_ConversationsTip}"
                                                       Click="OnOpenProjectConversationsClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Primary" 
                                                       Margin="0,0,8,0"
                                                       Padding="10,5"
                                                       Icon="{ui:SymbolIcon Symbol=Chat24}"/>
                                            <ui:Button AutomationProperties.AutomationId="ProjectRowActions" Content="{DynamicResource Projects_ActionsBtn}"
                                                       ToolTip="{DynamicResource Projects_ActionsTip}"
                                                       Click="OnOpenProjectActionsClicked" 
                                                       Tag="{Binding Id}" 
                                                       Appearance="Secondary" 
                                                       Padding="10,5"
                                                       Icon="{ui:SymbolIcon Symbol=Options24}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                
                <Grid x:Name="ToolsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

